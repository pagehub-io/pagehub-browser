# pagehub-browser local dev config
# NOTE: ENV=development activates the X-Twin-* header-override path; every deployed
# environment (Modal, docker-compose-for-not-dev) MUST override ENV to production/staging.
ENV=development
SERVICE_NAME=pagehub-browser
GIT_COMMIT=local-dev

# session registry / reaper
MAX_SESSIONS=20
IDLE_TIMEOUT_SECONDS=300
IDLE_TIMEOUT_MAX_SECONDS=900
REAPER_INTERVAL_SECONDS=30
TOMBSTONE_MAX=256

# per-session log ring buffers (console + network), drop-oldest past this
MAX_LOG_ENTRIES=500

# request body size limit (bytes) — 1 MiB; larger -> 413
REQUEST_BODY_MAX_BYTES=1048576

# DEV-ONLY SSRF escape hatch. With ENV=development this lets `navigate` reach loopback /
# RFC1918 / link-local hosts so the local docker-compose loop can drive a LOCAL target
# frontend (localhost / host.docker.internal / the docker bridge). IGNORED in any other env
# — staging/qa/prod always keep the strict deny-list. Default true here because .env.example
# IS the local-dev file and the local eval loop needs it; never set this on a deploy.
BROWSER_ALLOW_PRIVATE_HOSTS=true

# default browser context
DEFAULT_VIEWPORT_WIDTH=1280
DEFAULT_VIEWPORT_HEIGHT=720
HEADLESS=true

# timeouts (ms) — ACTION_TIMEOUT_MAX_MS is deliberately below the Modal function timeout (120000)
ACTION_TIMEOUT_MAX_MS=110000
MODAL_FUNCTION_TIMEOUT_MS=120000
LOCK_ACQUIRE_TIMEOUT_MS=5000

# error reporting (optional) — leave unset locally; Sentry init is a no-op if absent
# SENTRY_DSN=

# Bearer token for /v1/admin/* endpoints (currently: POST /v1/admin/reset-sessions).
# Fail-closed: when unset, every admin request returns 401. Set this on any deploy that
# needs an operator escape hatch for state purges. Never commit a real token.
# ADMIN_AUTH_TOKEN=

# local dev
PORT=4010
LOG_LEVEL=INFO
